#include <Arduino.h>
#include <Wire.h>
#include "DFRobotDFPlayerMini.h"
#include <Preferences.h>

Preferences prefs;

#define LED_PIN 2

//
// ---- Konfigurasi PCF8575 ----
//
#define NUM_MODULES 8
#define BASE_ADDR  0x20
const unsigned long READ_INTERVAL = 50;
unsigned long lastRead = 0;

uint16_t lastState[NUM_MODULES];
bool isPressed[NUM_MODULES][16] = {false};

//
// ---- DFPlayer Mini ----
//
HardwareSerial mySerial(1);
DFRobotDFPlayerMini myDFPlayer;
bool dfConnected = false;

//
// ---- Fungsi PCF8575 ----
//
uint16_t readPCF8575(uint8_t addr) {
  uint16_t value = 0xFFFF;
  Wire.requestFrom(addr, (uint8_t)2);
  if (Wire.available() >= 2) {
    uint8_t low = Wire.read();
    uint8_t high = Wire.read();
    value = ((uint16_t)high << 8) | low;
  }
  return value;
}

bool writePCF8575(uint8_t addr, uint16_t value) {
  Wire.beginTransmission(addr);
  Wire.write(value & 0xFF);
  Wire.write((value >> 8) & 0xFF);
  return (Wire.endTransmission() == 0);
}

int computeIndexFromString(const char* nilai) {
  int len = strlen(nilai);
  if (len < 3) return -1;

  int lastTwo = atoi(nilai + len - 2);
  int angka = (lastTwo > 7) ? lastTwo - 2 : lastTwo;

  char ch = nilai[len - 3];
  int digitTunggal = ch - '0';
  if (digitTunggal < 0 || digitTunggal > 9) return -1;

  int index = (digitTunggal * 16) + angka + 1;
  return index;
}

//
// ---- Setup ----
//
void setup() {

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, HIGH);

  Serial.begin(115200);
  delay(500);

  Wire.begin();
  Wire.setClock(400000);

  // Inisialisasi PCF8575
  for (uint8_t i = 0; i < NUM_MODULES; i++) {
    uint8_t addr = BASE_ADDR + i;
    writePCF8575(addr, 0xFFFF);
    lastState[i] = readPCF8575(addr);
  }

  Serial.println("=== MONITOR MULTI-TOMBOL + DFPlayer ===");

  //
  // ---- Inisialisasi DFPlayer dengan Delay & Retry ----
  //
  mySerial.begin(9600, SERIAL_8N1, 16, 17);

  delay(300);   // ⬅️ WAJIB: beri waktu DFPlayer boot

  Serial.println("Menghubungkan ke DFPlayer...");

  for (int i = 0; i < 5; i++) {
    if (myDFPlayer.begin(mySerial)) {
      dfConnected = true;
      break;
    }
    Serial.println("Retry koneksi DFPlayer...");
    delay(1000);
  }

  if (dfConnected) {
    Serial.println("DFPlayer berhasil terhubung!");
    myDFPlayer.volume(23);
  } else {
    Serial.println("DFPlayer gagal terhubung!");
  }

  //
  // ---- Boot Counter Aman ----
  //
  prefs.begin("boot", false);

  int bootCount = prefs.getInt("count", 0);
  bootCount++;

  Serial.print("Boot count: ");
  Serial.println(bootCount);

  prefs.putInt("count", bootCount);

  // Restart hanya sekali dan beri delay agar DFPlayer stabil
  if (bootCount == 1) {
    Serial.println("Restart aman...");
    delay(300);   // ⬅️ penting
    ESP.restart();
  }

  // Reset counter
  prefs.putInt("count", 0);
  prefs.end();

  digitalWrite(LED_PIN, LOW);

  Serial.println("Boot normal");
}

//
// ---- Loop ----
//
void loop() {

  unsigned long now = millis();
  if (now - lastRead >= READ_INTERVAL) {

    lastRead = now;

    for (uint8_t mod = 0; mod < NUM_MODULES; mod++) {

      uint8_t addr = BASE_ADDR + mod;
      uint16_t val = readPCF8575(addr);

      for (uint8_t bit = 0; bit < 16; bit++) {

        bool pressedNow = ((val & (1 << bit)) == 0);

        if (pressedNow && !isPressed[mod][bit]) {

          isPressed[mod][bit] = true;

          int pinLabel = (bit < 8) ? bit : bit + 2;

          char index[4];
          snprintf(index, sizeof(index), "%d%02d", mod, pinLabel);

          // mapping khusus
          if (strcmp(index, "502") == 0) strcpy(index, "416");
          else if (strcmp(index, "503") == 0) strcpy(index, "414");
          else if (strcmp(index, "504") == 0) strcpy(index, "412");
          else if (strcmp(index, "505") == 0) strcpy(index, "400");
          else if (strcmp(index, "506") == 0) strcpy(index, "413");
          else if (strcmp(index, "400") == 0) strcpy(index, "410");
          else if (strcmp(index, "407") == 0) strcpy(index, "404");
          else if (strcmp(index, "404") == 0) strcpy(index, "405");
          else if (strcmp(index, "405") == 0) strcpy(index, "407");

          Serial.print("Index: ");
          Serial.println(index);

          int idx = computeIndexFromString(index);
          int indexValue = atoi(index);

          if (indexValue >= 510) idx -= 6;
          if (indexValue >= 706) idx -= 2;

          if (dfConnected && idx > 0) {
            myDFPlayer.play(idx);
          }
        }

        else if (!pressedNow && isPressed[mod][bit]) {
          isPressed[mod][bit] = false;
        }
      }

      lastState[mod] = val;
    }
  }
}
